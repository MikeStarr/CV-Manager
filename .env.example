# CV Manager Environment Configuration Example
# Copy this file to '.env' and fill in your API keys

# DeepSeek API Configuration
# Get your key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Grok (xAI) API Configuration
# Get your key from https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# Local LLM / Custom OpenAI-Compatible API Configuration (Optional)
# Defaults are shown below; uncomment and modify to override
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=lm-studio
# LM_STUDIO_MODEL=llama-3.1-8b-instruct
# OPENAI_TIMEOUT=60

